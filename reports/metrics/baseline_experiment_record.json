      {"filters": 64, "kernel": [3, 3], "batch_norm": true, "activation": "relu", "pool": [2, 2]},
      {"filters": 128, "kernel": [3, 3], "batch_norm": true, "activation": "relu", "pool": [2, 2]}
    ],
    "pooling": "GlobalAveragePooling2D",
    "classification_head": [
      {"units": 64, "activation": "relu", "l2_reg": 1e-4},
      {"dropout_rate": 0.3},
      {"units": 1, "activation": "sigmoid"}
    ],
    "total_parameters": 101889,
    "trainable_parameters": 101441,
    "non_trainable_parameters": 448
